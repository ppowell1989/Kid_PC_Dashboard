<Application x:Class="KidsPc.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Retro space theme: black sky, neon planets, chunky glowing tiles and buttons with a hard "3D" edge.
         Display type is Bungee (SIL Open Font License, Assets\Fonts\OFL.txt), built into the exe. -->
    <RadialGradientBrush x:Key="Bg" Center="0.25,0.1" GradientOrigin="0.25,0.1" RadiusX="1.1" RadiusY="1.1">
      <GradientStop Color="#1B0B4A" Offset="0"/>
      <GradientStop Color="#0B0628" Offset="0.5"/>
      <GradientStop Color="#03020F" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Card" Color="#F2140C44"/>
    <SolidColorBrush x:Key="Panel" Color="#F21A1060"/>
    <SolidColorBrush x:Key="Well" Color="#E60A0630"/>
    <SolidColorBrush x:Key="Line" Color="#4B3BB0"/>
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#B3A9E8"/>
    <SolidColorBrush x:Key="Accent" Color="#FF2E97"/>
    <SolidColorBrush x:Key="Cyan" Color="#22E4FF"/>
    <SolidColorBrush x:Key="Warn" Color="#FFD23F"/>
    <SolidColorBrush x:Key="Lime" Color="#7DFF5A"/>
    <SolidColorBrush x:Key="Orange" Color="#FF8A00"/>
    <SolidColorBrush x:Key="Violet" Color="#9B5CFF"/>
    <SolidColorBrush x:Key="Ink" Color="#06122B"/>
    <LinearGradientBrush x:Key="Neon" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF6AB5" Offset="0"/>
      <GradientStop Color="#FF2E97" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rainbow" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#22E4FF" Offset="0"/>
      <GradientStop Color="#FF2E97" Offset="0.5"/>
      <GradientStop Color="#FFD23F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gold" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFF48A" Offset="0.1"/>
      <GradientStop Color="#FFD23F" Offset="0.5"/>
      <GradientStop Color="#FF8A00" Offset="0.95"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CyanFace" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#7DF1FF" Offset="0"/>
      <GradientStop Color="#22E4FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FuelOk" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#7DFF5A" Offset="0"/>
      <GradientStop Color="#C8FF5A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FuelLow" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF8A00" Offset="0"/>
      <GradientStop Color="#FFD23F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FuelEmpty" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#C4102C" Offset="0"/>
      <GradientStop Color="#FF4D5E" Offset="1"/>
    </LinearGradientBrush>
    <!-- Black and yellow caution stripes for the "time is nearly up" banner. -->
    <LinearGradientBrush x:Key="Hazard" StartPoint="0,0" EndPoint="24,24" MappingMode="Absolute" SpreadMethod="Repeat">
      <GradientStop Color="#FFD23F" Offset="0"/>
      <GradientStop Color="#FFD23F" Offset="0.5"/>
      <GradientStop Color="#1B1D21" Offset="0.5"/>
      <GradientStop Color="#1B1D21" Offset="1"/>
    </LinearGradientBrush>
    <!-- Little planets used as button icons. -->
    <RadialGradientBrush x:Key="PlanetPink" GradientOrigin="0.3,0.28" Center="0.4,0.4" RadiusX="0.75" RadiusY="0.75">
      <GradientStop Color="#FFD1EC" Offset="0"/><GradientStop Color="#FF2E97" Offset="0.5"/><GradientStop Color="#6A0DAD" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="PlanetCyan" GradientOrigin="0.3,0.28" Center="0.4,0.4" RadiusX="0.75" RadiusY="0.75">
      <GradientStop Color="#D9FBFF" Offset="0"/><GradientStop Color="#22E4FF" Offset="0.5"/><GradientStop Color="#1B3BFF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="PlanetGold" GradientOrigin="0.3,0.28" Center="0.4,0.4" RadiusX="0.75" RadiusY="0.75">
      <GradientStop Color="#FFF7C2" Offset="0"/><GradientStop Color="#FFD23F" Offset="0.5"/><GradientStop Color="#FF6A00" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="PlanetLime" GradientOrigin="0.3,0.28" Center="0.4,0.4" RadiusX="0.75" RadiusY="0.75">
      <GradientStop Color="#E2FFD9" Offset="0"/><GradientStop Color="#7DFF5A" Offset="0.5"/><GradientStop Color="#0A7A4A" Offset="1"/>
    </RadialGradientBrush>

    <FontFamily x:Key="Display">/KidsPcShell;component/Assets/Fonts/#Bungee, Bahnschrift SemiBold, Segoe UI Black, Segoe UI</FontFamily>
    <FontFamily x:Key="Body">Bahnschrift, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol</FontFamily>

    <!-- No implicit TextBlock style on purpose: it would override the font and colour that buttons hand down
         to their labels. The window sets the body font and white text; everything inherits from there. -->

    <!-- Section heading: chunky cyan caps. -->
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
    </Style>

    <!-- Scroll bars: a slim violet thumb instead of the grey Windows one. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="#660A0630" CornerRadius="6">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="6" Background="#9B5CFF"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text boxes: dark well, neon edge when typing. -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Well}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="#22E4FF"/>
      <Setter Property="SelectionBrush" Value="#FF2E97"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="FontFamily" Value="{StaticResource Body}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Game tile: art on top, name plate below, thick neon frame with a hard lower edge. Lifts and glows on hover.
         Background = the art (or a poster colour), BorderBrush = the frame colour, Tag = an icon glyph for tiles with no art. -->
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Width" Value="342"/>
      <Setter Property="Height" Value="240"/>
      <Setter Property="Background" Value="{StaticResource PlanetCyan}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
      <Setter Property="Margin" Value="0,0,22,20"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Margin="0,10,0,0" CornerRadius="24" Background="{TemplateBinding BorderBrush}" Opacity="0.4"/>
              <Border x:Name="b" Margin="0,0,0,10" CornerRadius="24" Background="{StaticResource Card}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="4">
                <Border.Effect><DropShadowEffect Color="#22E4FF" BlurRadius="0" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border CornerRadius="19,19,0,0" Background="{TemplateBinding Background}"/>
                  <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Icons}"
                             FontSize="72" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Border CornerRadius="19,19,0,0" BorderBrush="#50FFFFFF" BorderThickness="0,2,0,0"/>
                  <Border Grid.Row="1" MinHeight="62" Padding="16,8,16,10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,3,0,0">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)" To="34" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)" To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Margin" Value="0,7,0,3"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Chunky push button. Background = the face colour; it sinks onto its dark edge when pressed. -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Padding" Value="22,10,22,9"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Neon}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Margin="0,6,0,0" CornerRadius="16" Background="{TemplateBinding Background}"/>
              <Border Margin="0,6,0,0" CornerRadius="16" Background="#99000000"/>
              <Border x:Name="p" Margin="0,0,0,6" CornerRadius="16" Background="{TemplateBinding Background}"
                      BorderBrush="#66FFFFFF" BorderThickness="0,2,0,0" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="p" Property="Effect">
                  <Setter.Value><DropShadowEffect Color="#FFFFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="p" Property="BorderBrush" Value="White"/>
                <Setter TargetName="p" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="p" Property="Margin" Value="0,5,0,1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Top navigation: a planet and a label on a console button. Tag="on" marks the page you are on.
         Background = the planet, BorderBrush = its colour. -->
    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Height" Value="70"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource PlanetCyan}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Margin="0,7,0,0" CornerRadius="32" Background="{TemplateBinding BorderBrush}" Opacity="0.4"/>
              <Border x:Name="f" Margin="0,0,0,7" CornerRadius="32" Background="{StaticResource Card}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="3" Padding="10,0,26,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Grid Width="42" Height="42" Margin="0,0,12,0">
                    <Ellipse Fill="{TemplateBinding Background}"/>
                    <Ellipse Stroke="#33000000" StrokeThickness="2"/>
                  </Grid>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="f" Property="Background" Value="#FF2A1A7A"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="f" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="f" Property="BorderBrush" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="f" Property="Margin" Value="0,5,0,2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
