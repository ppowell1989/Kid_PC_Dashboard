<Application x:Class="KidsPc.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Retro space theme: deep-space background, neon planets, glowing tiles. -->
    <RadialGradientBrush x:Key="Bg" Center="0.3,0.2" GradientOrigin="0.3,0.2" RadiusX="1.2" RadiusY="1.2">
      <GradientStop Color="#2A1260" Offset="0"/>
      <GradientStop Color="#120A3A" Offset="0.45"/>
      <GradientStop Color="#05041A" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Card" Color="#CC1C1452"/>
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#B3A9E8"/>
    <SolidColorBrush x:Key="Accent" Color="#FF2E97"/>
    <SolidColorBrush x:Key="Cyan" Color="#22E4FF"/>
    <SolidColorBrush x:Key="Warn" Color="#FFD23F"/>
    <LinearGradientBrush x:Key="Neon" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF2E97" Offset="0"/>
      <GradientStop Color="#FF8A00" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Rainbow" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#22E4FF" Offset="0"/>
      <GradientStop Color="#FF2E97" Offset="0.5"/>
      <GradientStop Color="#FFD23F" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="Display">Bahnschrift SemiBold, Segoe UI Black, Segoe UI</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
    </Style>

    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Width" Value="300"/>
      <Setter Property="Height" Value="140"/>
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="Margin" Value="0,0,20,20"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="20" Background="{TemplateBinding Background}" BorderBrush="#4B3BB0" BorderThickness="2" Padding="16">
              <Border.Effect><DropShadowEffect Color="#22E4FF" BlurRadius="0" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
              <ContentPresenter VerticalAlignment="Bottom" TextElement.FontFamily="{StaticResource Display}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)" To="28" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)" To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="b" Property="BorderThickness" Value="3"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Neon}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="p" CornerRadius="22" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <Border.Effect><DropShadowEffect Color="#FF2E97" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="p" Property="Effect">
                  <Setter.Value><DropShadowEffect Color="#FF2E97" BlurRadius="22" ShadowDepth="0" Opacity="1"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="p" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
