<Application x:Class="KidsPc.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- The look lives in one theme file (Themes\*.xaml). Theme.cs swaps this entry for the kid's choice. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KidsPcShell;component/Themes/Clean.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

      <!-- A choice in the theme picker. Tag="on" marks the one in use. Not themed itself: it shows other themes. -->
      <Style x:Key="Swatch" TargetType="Button">
        <Setter Property="Margin" Value="0,0,16,16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="f" CornerRadius="16" BorderBrush="Transparent" BorderThickness="4" Padding="8" Background="Transparent">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="f" Property="Background" Value="{DynamicResource Well}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="f" Property="BorderBrush" Value="{DynamicResource Muted}"/>
                </Trigger>
                <Trigger Property="Tag" Value="on">
                  <Setter TargetName="f" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
