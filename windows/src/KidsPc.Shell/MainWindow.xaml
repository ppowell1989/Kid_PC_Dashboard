<Window x:Class="KidsPc.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="False" ShowInTaskbar="False" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Body}" Foreground="White" UseLayoutRounding="True">
  <Grid>
    <!-- Starfield and planets (drawn in code, MainWindow.Space.cs) -->
    <Canvas x:Name="Stars" IsHitTestVisible="False" ClipToBounds="True"/>

    <!-- ======================= Home / catalogue ======================= -->
    <DockPanel Margin="48,30,48,58">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
        <StackPanel Orientation="Horizontal">
          <!-- Logo: a ringed planet -->
          <Grid Width="96" Height="96" Margin="6,0,26,0" VerticalAlignment="Center">
            <Ellipse Width="150" Height="40" Margin="-27,0" Stroke="#0FA8C4" StrokeThickness="5" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><RotateTransform Angle="-18"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Fill="{StaticResource PlanetPink}">
              <Ellipse.Effect><DropShadowEffect Color="#FF2E97" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="150" Height="40" Margin="-27,0" Stroke="{StaticResource Cyan}" StrokeThickness="5"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><RotateTransform Angle="-18"/></Ellipse.RenderTransform>
              <Ellipse.Clip><RectangleGeometry Rect="0,19,150,30"/></Ellipse.Clip>
            </Ellipse>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <!-- Two layers of the same words: the solid letters sit on their own 3D shade. -->
            <Grid>
              <TextBlock Text="{Binding Text, ElementName=Greeting}" FontSize="60" FontFamily="{StaticResource DisplayShade}" Foreground="{StaticResource Accent}"/>
              <TextBlock x:Name="Greeting" FontSize="60" FontFamily="{StaticResource Display}" Foreground="{StaticResource Gold}" Text="Hi!"/>
            </Grid>
            <TextBlock x:Name="Clock" FontSize="17" FontFamily="{StaticResource Display}" Foreground="{StaticResource Cyan}" Margin="4,-6,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- Time left today, as a fuel gauge -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="360">
          <DockPanel>
            <TextBlock x:Name="TimeLeftLabel" DockPanel.Dock="Left" VerticalAlignment="Bottom" Margin="4,0,0,12"
                       FontSize="15" FontFamily="{StaticResource Display}" Foreground="{StaticResource Cyan}" Text="Time left today"/>
            <TextBlock x:Name="TimeLeft" HorizontalAlignment="Right" FontSize="50" FontFamily="{StaticResource Display}" Foreground="{StaticResource Gold}" Text="--">
              <TextBlock.Effect><DropShadowEffect Color="#FF8A00" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
            </TextBlock>
          </DockPanel>
          <Border Height="28" CornerRadius="14" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="3">
            <Grid x:Name="FuelLane" Margin="3">
              <Border x:Name="FuelFill" HorizontalAlignment="Left" Width="0" CornerRadius="8" Background="{StaticResource FuelOk}"/>
              <UniformGrid Rows="1" Columns="10">
                <Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/><Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/>
                <Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/><Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/>
                <Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/><Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/>
                <Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/><Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/>
                <Border BorderBrush="#0A0630" BorderThickness="0,0,3,0"/><Border/>
              </UniformGrid>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <!-- A message from Mom or Dad -->
      <Border x:Name="MessageBanner" DockPanel.Dock="Top" Background="{StaticResource Neon}" BorderBrush="White" BorderThickness="3" CornerRadius="20"
              Padding="20,10,10,10" Margin="0,0,0,14" Visibility="Collapsed">
        <Border.Effect><DropShadowEffect Color="#FF2E97" BlurRadius="26" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="12,0,0,0" Background="#2A1260" Content="OK" Click="DismissMessage"/>
          <TextBlock x:Name="MessageText" Foreground="White" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- Time is nearly up -->
      <Border x:Name="WarningBanner" DockPanel.Dock="Top" Background="{StaticResource Hazard}" CornerRadius="20"
              Padding="14,8" Margin="0,0,0,18" Visibility="Collapsed">
        <Border Background="{StaticResource Warn}" CornerRadius="12" Padding="18,8">
          <TextBlock x:Name="WarningText" Foreground="#1B1D21" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        </Border>
      </Border>

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
        <Button x:Name="NavHome" Style="{StaticResource Nav}" Tag="on" Background="{StaticResource PlanetPink}" BorderBrush="{StaticResource Accent}" Content="My games" Click="ShowHome"/>
        <Button x:Name="NavMore" Style="{StaticResource Nav}" Background="{StaticResource PlanetCyan}" BorderBrush="{StaticResource Cyan}" Content="Get more games" Click="ShowCatalogue"/>
        <Button Style="{StaticResource Nav}" Background="{StaticResource PlanetGold}" BorderBrush="{StaticResource Warn}" Content="Ask for more time" Tag="15" Click="AskForTimeHome"/>
      </StackPanel>
      <Border DockPanel.Dock="Top" Height="4" CornerRadius="2" Background="{StaticResource Rainbow}" Opacity="0.85" Margin="0,0,0,22"/>

      <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Foreground="{StaticResource Warn}" FontSize="16" FontWeight="SemiBold"/>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-12,-12,-12,0" Padding="12,12,12,0">
        <StackPanel>
          <WrapPanel x:Name="HomeTiles"/>
          <StackPanel x:Name="CataloguePanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,14" Text="Games Mom and Dad have approved"/>
            <WrapPanel x:Name="CatalogueTiles"/>
            <TextBlock Style="{StaticResource Heading}" Foreground="{StaticResource Warn}" Margin="0,22,0,14" Text="Want something else? Search the galaxy"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="AskGameBox" Width="460" Height="52" FontSize="20" Padding="14,0" KeyDown="SearchKeyDown"/>
              <Button Style="{StaticResource Pill}" Margin="14,0,0,0" Background="{StaticResource CyanFace}" Foreground="{StaticResource Ink}" Content="Search" Click="SearchGames"/>
              <Button Style="{StaticResource Pill}" Margin="14,0,0,0" Background="#3B2A8F" Content="Ask for it by name" Click="AskForGame"/>
            </StackPanel>
            <TextBlock x:Name="SearchStatus" FontSize="18" Foreground="{StaticResource Muted}" Margin="2,14,0,0" TextWrapping="Wrap"/>
            <WrapPanel x:Name="SearchResults" Margin="0,14,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ======================= News ticker along the bottom edge ======================= -->
    <Border VerticalAlignment="Bottom" Height="38" Background="#D903020F" BorderBrush="{StaticResource Rainbow}" BorderThickness="0,3,0,0" IsHitTestVisible="False">
      <Canvas x:Name="TickerLane" ClipToBounds="True">
        <TextBlock x:Name="Ticker" Canvas.Top="6" Canvas.Left="48" FontSize="15" FontFamily="{StaticResource Display}" Foreground="{StaticResource Warn}"/>
      </Canvas>
    </Border>

    <!-- ======================= Lock screen ======================= -->
    <Grid x:Name="LockOverlay" Background="#F203020F" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="1100">
        <!-- A sleepy moon -->
        <Grid Width="190" Height="190" Margin="0,0,0,26">
          <Ellipse Fill="{StaticResource PlanetGold}">
            <Ellipse.Effect><DropShadowEffect Color="#FFD23F" BlurRadius="60" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
          </Ellipse>
          <Ellipse Width="44" Height="44" Fill="#33A34A00" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="42,36,0,0"/>
          <Ellipse Width="26" Height="26" Fill="#33A34A00" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="112,84,0,0"/>
          <Ellipse Width="34" Height="34" Fill="#33A34A00" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="62,118,0,0"/>
          <Ellipse Width="16" Height="16" Fill="#33A34A00" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="126,40,0,0"/>
        </Grid>
        <Grid HorizontalAlignment="Center">
          <TextBlock Text="{Binding Text, ElementName=LockTitle}" FontSize="58" FontFamily="{StaticResource DisplayShade}" Foreground="{StaticResource Accent}" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock x:Name="LockTitle" FontSize="58" FontFamily="{StaticResource Display}" Foreground="{StaticResource Gold}" TextAlignment="Center" TextWrapping="Wrap" Text="Time's up for today"/>
        </Grid>
        <TextBlock x:Name="LockSub" FontSize="24" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,26"/>
        <TextBlock x:Name="LockMessage" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,26" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource Pill}" FontSize="20" Padding="28,14,28,12" Content="Ask for 15 more minutes" Tag="15" Click="AskForTime"/>
          <Button Style="{StaticResource Pill}" FontSize="20" Padding="28,14,28,12" Margin="0" Background="{StaticResource CyanFace}" Foreground="{StaticResource Ink}" Content="Ask for 30" Tag="30" Click="AskForTime"/>
        </StackPanel>
        <TextBlock x:Name="LockStatus" FontSize="18" Foreground="{StaticResource Lime}" TextAlignment="Center" Margin="0,20,0,0"/>
        <Button Style="{StaticResource Pill}" Margin="0,36,0,0" HorizontalAlignment="Center" Background="#3B2A8F" Content="Shut down" Click="ShutDown"/>
      </StackPanel>
    </Grid>

    <!-- ======================= "Ask Mom or Dad for this game?" ======================= -->
    <Grid x:Name="AskOverlay" Background="#D903020F" Visibility="Collapsed">
      <Grid Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Margin="0,12,0,-12" CornerRadius="30" Background="#0A7FA3"/>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Cyan}" BorderThickness="4" CornerRadius="30" Padding="28">
          <Border.Effect><DropShadowEffect Color="#22E4FF" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
          <StackPanel>
            <TextBlock FontSize="20" FontFamily="{StaticResource Display}" Foreground="{StaticResource Warn}" Margin="0,-4,0,14" Text="Ask Mom or Dad for this game?"/>
            <Border CornerRadius="16" Height="258" BorderBrush="{StaticResource Line}" BorderThickness="3" Margin="0,0,0,18">
              <Border.Background><ImageBrush x:Name="AskArt" Stretch="UniformToFill"/></Border.Background>
            </Border>
            <TextBlock x:Name="AskTitle" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
            <Border HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3,10,2" CornerRadius="8" BorderBrush="{StaticResource Warn}" BorderThickness="2">
              <TextBlock x:Name="AskRating" FontSize="14" FontFamily="{StaticResource Display}" Foreground="{StaticResource Warn}"/>
            </Border>
            <TextBlock x:Name="AskBlurb" FontSize="16" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,12,0,0" MaxHeight="84"/>
            <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,18,0,8" Text="Why do you want it? (optional)"/>
            <TextBox x:Name="AskNote" FontSize="18" Height="50" Padding="12,0" MaxLength="200"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button Style="{StaticResource Pill}" Background="#3B2A8F" Content="Never mind" Click="CancelAsk"/>
              <Button x:Name="AskSend" Style="{StaticResource Pill}" Margin="0" Content="Ask Mom or Dad" Click="ConfirmAsk"/>
            </StackPanel>
            <TextBlock x:Name="AskStatus" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ======================= Family chat (above the lock screen, so he can always reach Mom and Dad) ======================= -->
    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,62">
      <Button x:Name="ChatPill" Style="{StaticResource Pill}" Margin="0" FontSize="19" Padding="24,13,24,11" Background="{StaticResource CyanFace}" Foreground="{StaticResource Ink}"
              Click="ToggleChat" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock Text="Family chat" VerticalAlignment="Center"/>
          <Border x:Name="ChatBadge" Background="#FF4D5E" CornerRadius="12" MinWidth="24" Height="24" Padding="6,0" Margin="10,0,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ChatBadgeText" Foreground="White" FontSize="14" FontFamily="{StaticResource Body}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Button>
      <Grid x:Name="ChatPanel" Visibility="Collapsed" Width="430" Height="560">
        <Border Margin="0,10,0,-10" CornerRadius="26" Background="#A30F5C"/>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="4" CornerRadius="26" Padding="16">
          <Border.Effect><DropShadowEffect Color="#FF2E97" BlurRadius="34" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0" FontSize="14" Padding="16,8,16,7" Background="#3B2A8F" Content="Hide" Click="ToggleChat"/>
              <TextBlock Text="Family chat" FontSize="22" FontFamily="{StaticResource Display}" Foreground="{StaticResource Warn}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="10,0,0,0" Content="Send" Click="SendChat"/>
              <TextBox x:Name="ChatBox" FontSize="17" Height="48" Padding="12,0" MaxLength="500" KeyDown="ChatKeyDown" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="ChatStatus" DockPanel.Dock="Bottom" FontSize="13" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
            <Border Background="{StaticResource Well}" CornerRadius="16" Padding="10,10,4,10">
              <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatLog" Margin="0,0,8,0"/>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
