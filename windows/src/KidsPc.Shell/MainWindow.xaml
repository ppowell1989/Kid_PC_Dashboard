<Window x:Class="KidsPc.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="False" ShowInTaskbar="False" Background="{StaticResource Bg}">
  <Grid>
    <!-- Starfield and planets (drawn in code, MainWindow.Space.cs) -->
    <Canvas x:Name="Stars" IsHitTestVisible="False" ClipToBounds="True"/>

    <!-- ======================= Home / catalogue ======================= -->
    <DockPanel Margin="48,36">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock x:Name="Greeting" FontSize="52" FontFamily="{StaticResource Display}" Foreground="{StaticResource Rainbow}" Text="Hi!">
            <TextBlock.Effect><DropShadowEffect Color="#FF2E97" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
          </TextBlock>
          <TextBlock x:Name="Clock" FontSize="18" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="TimeLeft" FontSize="48" FontFamily="{StaticResource Display}" Foreground="{StaticResource Warn}" HorizontalAlignment="Right" Text="--">
            <TextBlock.Effect><DropShadowEffect Color="#FFD23F" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
          </TextBlock>
          <TextBlock x:Name="TimeLeftLabel" FontSize="16" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Text="left today"/>
        </StackPanel>
      </Grid>

      <Border x:Name="MessageBanner" DockPanel.Dock="Top" Background="{StaticResource Neon}" CornerRadius="16"
              Padding="16,10" Margin="0,0,0,12" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="Transparent" Content="OK" Click="DismissMessage"/>
          <TextBlock x:Name="MessageText" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Border x:Name="WarningBanner" DockPanel.Dock="Top" Background="{StaticResource Warn}" CornerRadius="16"
              Padding="16,10" Margin="0,0,0,20" Visibility="Collapsed">
        <TextBlock x:Name="WarningText" Foreground="#1B1D21" FontSize="18" FontWeight="SemiBold"/>
      </Border>

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20">
        <Button Style="{StaticResource Pill}" Content="My games" Click="ShowHome"/>
        <Button Style="{StaticResource Pill}" Content="Get more games" Click="ShowCatalogue"/>
        <Button Style="{StaticResource Pill}" Content="Ask for more time" Tag="15" Click="AskForTimeHome"/>
      </StackPanel>

      <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="14"/>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <WrapPanel x:Name="HomeTiles"/>
          <StackPanel x:Name="CataloguePanel" Visibility="Collapsed">
            <TextBlock FontSize="26" FontFamily="{StaticResource Display}" Foreground="{StaticResource Cyan}" Margin="0,0,0,14" Text="Games Mom and Dad have approved"/>
            <WrapPanel x:Name="CatalogueTiles"/>
            <TextBlock FontSize="26" FontFamily="{StaticResource Display}" Foreground="{StaticResource Cyan}" Margin="0,28,0,14" Text="Want something else? Search the galaxy"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="AskGameBox" Width="420" FontSize="18" Padding="10,8" KeyDown="SearchKeyDown"/>
              <Button Style="{StaticResource Pill}" Margin="12,0,0,0" Content="Search" Click="SearchGames"/>
              <Button Style="{StaticResource Pill}" Margin="12,0,0,0" Content="Ask for it by name" Click="AskForGame"/>
            </StackPanel>
            <TextBlock x:Name="SearchStatus" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <WrapPanel x:Name="SearchResults" Margin="0,12,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ======================= Lock screen ======================= -->
    <Grid x:Name="LockOverlay" Background="#EE07051E" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
        <TextBlock x:Name="LockTitle" FontSize="52" FontFamily="{StaticResource Display}" Foreground="{StaticResource Rainbow}" TextAlignment="Center" Text="Time's up for today"/>
        <TextBlock x:Name="LockSub" FontSize="20" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,28"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource Pill}" Content="Ask for 15 more minutes" Tag="15" Click="AskForTime"/>
          <Button Style="{StaticResource Pill}" Content="Ask for 30" Tag="30" Click="AskForTime"/>
        </StackPanel>
        <TextBlock x:Name="LockMessage" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" Visibility="Collapsed"/>
        <TextBlock x:Name="LockStatus" FontSize="16" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,20,0,0"/>
        <Button Style="{StaticResource Pill}" Margin="0,40,0,0" HorizontalAlignment="Center" Content="Shut down" Click="ShutDown"/>
      </StackPanel>
    </Grid>

    <!-- ======================= Family chat (above the lock screen, so he can always reach Mom and Dad) ======================= -->
    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,28">
      <Button x:Name="ChatPill" Style="{StaticResource Pill}" Click="ToggleChat" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Family chat" Foreground="White" VerticalAlignment="Center"/>
          <Border x:Name="ChatBadge" Background="#E5484D" CornerRadius="10" MinWidth="22" Padding="6,0" Margin="8,0,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ChatBadgeText" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Button>
      <Border x:Name="ChatPanel" Visibility="Collapsed" Width="400" Height="500" Background="{StaticResource Card}"
              BorderBrush="#4B3BB0" BorderThickness="2" CornerRadius="20" Padding="14">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="Hide" Click="ToggleChat"/>
            <TextBlock Text="Family chat" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="8,0,0,0" Content="Send" Click="SendChat"/>
            <TextBox x:Name="ChatBox" FontSize="16" Padding="8,6" MaxLength="500" KeyDown="ChatKeyDown" VerticalContentAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="ChatStatus" DockPanel.Dock="Bottom" FontSize="13" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatLog"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
