<Window x:Class="KidsPc.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="False" ShowInTaskbar="False" Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource Body}" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
  <Grid>
    <!-- Soft washes of colour behind everything (drawn in code, MainWindow.Backdrop.cs) -->
    <Canvas x:Name="Backdrop" IsHitTestVisible="False" ClipToBounds="True"/>

    <!-- ======================= Home / catalogue ======================= -->
    <DockPanel Margin="56,40,56,36">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,26">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Greeting" FontSize="52" Style="{DynamicResource Title}" Text="Hi!"/>
          <TextBlock x:Name="Clock" FontSize="19" Foreground="{DynamicResource Muted}" Margin="2,2,0,0"/>
        </StackPanel>

        <!-- Time left today -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Width="390">
          <Border Style="{DynamicResource Shadow}"/>
          <Border Style="{DynamicResource CardBox}" Padding="24,14,24,20">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="TimeLeftLabel" DockPanel.Dock="Left" VerticalAlignment="Bottom" Margin="0,0,0,9"
                           FontSize="16" Foreground="{DynamicResource Muted}" Text="Time left today"/>
                <TextBlock x:Name="TimeLeft" HorizontalAlignment="Right" FontSize="38" FontFamily="{DynamicResource Display}" Foreground="{DynamicResource Text}" Text="--"/>
              </DockPanel>
              <Border Height="12" CornerRadius="6" Background="{DynamicResource Well}" Margin="0,6,0,0">
                <Grid x:Name="FuelLane" Width="342" HorizontalAlignment="Left">
                  <Border x:Name="FuelFill" HorizontalAlignment="Left" Width="0" CornerRadius="6" Background="{DynamicResource FuelOk}"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- A message from Mom or Dad -->
      <Border x:Name="MessageBanner" DockPanel.Dock="Top" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="2" CornerRadius="{DynamicResource RCard}"
              Padding="22,12,12,12" Margin="0,0,0,16" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{DynamicResource Pill}" Margin="14,0,0,0" Content="OK" Click="DismissMessage"/>
          <TextBlock DockPanel.Dock="Left" Text="&#xE8BD;" FontFamily="{DynamicResource Icons}" FontSize="26" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock x:Name="MessageText" FontSize="23" FontFamily="{DynamicResource Display}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- Time is nearly up -->
      <Border x:Name="WarningBanner" DockPanel.Dock="Top" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="2" CornerRadius="{DynamicResource RCard}"
              Padding="22,14" Margin="0,0,0,16" Visibility="Collapsed">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE916;" FontFamily="{DynamicResource Icons}" FontSize="26" Foreground="{DynamicResource WarnText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock x:Name="WarningText" Foreground="{DynamicResource WarnText}" FontSize="22" FontFamily="{DynamicResource Display}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,26">
        <Button DockPanel.Dock="Right" Style="{DynamicResource Pill}" Margin="0" Background="{DynamicResource Card}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}"
                Tag="15" Click="AskForTimeHome">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE916;" FontFamily="{DynamicResource Icons}" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,1,10,0"/>
            <TextBlock Text="Ask for more time" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Style="{DynamicResource Pill}" Margin="0,0,12,0" Background="{DynamicResource Card}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}"
                Click="OpenThemes">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE790;" FontFamily="{DynamicResource Icons}" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,1,10,0"/>
            <TextBlock Text="Themes" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource NavTray}">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="NavHome" Style="{DynamicResource Nav}" Tag="on" Content="My games" Click="ShowHome"/>
            <Button x:Name="NavMore" Style="{DynamicResource Nav}" Margin="4,0,0,0" Content="Get more games" Click="ShowCatalogue"/>
          </StackPanel>
        </Border>
      </DockPanel>

      <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Foreground="{DynamicResource WarnText}" FontSize="17" Margin="0,8,0,0"/>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-20,-14,-20,0" Padding="20,14,20,0">
        <StackPanel>
          <WrapPanel x:Name="HomeTiles"/>
          <StackPanel x:Name="CataloguePanel" Visibility="Collapsed">
            <TextBlock Style="{DynamicResource Heading}" Margin="0,0,0,16" Text="Games Mom and Dad have approved"/>
            <WrapPanel x:Name="CatalogueTiles"/>
            <TextBlock Style="{DynamicResource Heading}" Margin="0,18,0,16" Text="Want something else? Search for it"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="AskGameBox" Width="460" Height="52" FontSize="20" Padding="14,0" KeyDown="SearchKeyDown"/>
              <Button Style="{DynamicResource Pill}" Margin="14,0,0,0" Content="Search" Click="SearchGames"/>
              <Button Style="{DynamicResource Pill}" Margin="12,0,0,0" Background="{DynamicResource Card}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" Content="Ask for it by name" Click="AskForGame"/>
            </StackPanel>
            <TextBlock x:Name="SearchStatus" FontSize="18" Foreground="{DynamicResource Muted}" Margin="2,14,0,0" TextWrapping="Wrap"/>
            <WrapPanel x:Name="SearchResults" Margin="0,16,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ======================= Ticker along the bottom edge (only themes that ask for it) ======================= -->
    <Border VerticalAlignment="Bottom" Height="38" Background="{DynamicResource Scrim}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,3,0,0"
            IsHitTestVisible="False" Visibility="{DynamicResource TickerVisibility}">
      <Canvas x:Name="TickerLane" ClipToBounds="True">
        <TextBlock x:Name="Ticker" Canvas.Top="6" Canvas.Left="48" FontSize="15" FontFamily="{DynamicResource Display}" Foreground="{DynamicResource WarnSoft}"/>
      </Canvas>
    </Border>

    <!-- ======================= Lock screen ======================= -->
    <Grid x:Name="LockOverlay" Background="{DynamicResource Bg}" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="1000">
        <Grid Width="132" Height="132" Margin="0,0,0,30">
          <Ellipse Fill="{DynamicResource AccentSoft}"/>
          <TextBlock Text="&#xE708;" FontFamily="{DynamicResource Icons}" FontSize="60" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="LockTitle" FontSize="56" Style="{DynamicResource Title}" TextAlignment="Center" TextWrapping="Wrap" Text="Time's up for today"/>
        <TextBlock x:Name="LockSub" FontSize="24" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,28"/>
        <Border x:Name="LockMessageCard" HorizontalAlignment="Center" Background="{DynamicResource AccentSoft}" CornerRadius="{DynamicResource RCard}" Padding="24,14" Margin="0,0,0,28"
                Visibility="{Binding Visibility, ElementName=LockMessage}">
          <TextBlock x:Name="LockMessage" FontSize="24" FontFamily="{DynamicResource Display}" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Border>
        <StackPanel x:Name="LockAsk" Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{DynamicResource Pill}" FontSize="20" Padding="28,15,28,16" Content="Ask for 15 more minutes" Tag="15" Click="AskForTime"/>
          <Button Style="{DynamicResource Pill}" FontSize="20" Padding="28,15,28,16" Margin="0" Background="{DynamicResource Card}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" Content="Ask for 30" Tag="30" Click="AskForTime"/>
        </StackPanel>
        <TextBlock x:Name="LockStatus" FontSize="18" Foreground="{DynamicResource Good}" TextAlignment="Center" Margin="0,20,0,0"/>
        <Button Style="{DynamicResource Pill}" Margin="0,40,0,0" HorizontalAlignment="Center" Background="{DynamicResource Well}" Foreground="{DynamicResource Muted}" BorderBrush="{DynamicResource Line}" Content="Shut down" Click="ShutDown"/>
      </StackPanel>
    </Grid>

    <!-- ======================= "Ask Mom or Dad for this game?" ======================= -->
    <Grid x:Name="AskOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed">
      <Grid Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{DynamicResource Shadow}"/>
        <Border Style="{DynamicResource CardBox}" Padding="30">
          <StackPanel>
            <TextBlock FontSize="17" Foreground="{DynamicResource Muted}" Margin="0,-4,0,14" Text="Ask Mom or Dad for this game?"/>
            <Border CornerRadius="{DynamicResource RButton}" Height="262" Background="{DynamicResource Well}" Margin="0,0,0,18">
              <Border CornerRadius="{DynamicResource RButton}">
                <Border.Background><ImageBrush x:Name="AskArt" Stretch="UniformToFill"/></Border.Background>
              </Border>
            </Border>
            <TextBlock x:Name="AskTitle" FontSize="32" FontFamily="{DynamicResource Display}" TextWrapping="Wrap"/>
            <Border HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3,10,4" CornerRadius="8" Background="{DynamicResource Well}">
              <TextBlock x:Name="AskRating" FontSize="14" Foreground="{DynamicResource Muted}"/>
            </Border>
            <TextBlock x:Name="AskBlurb" FontSize="16" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,12,0,0" MaxHeight="88"/>
            <TextBlock FontSize="17" FontFamily="{DynamicResource Display}" Margin="0,18,0,8" Text="Why do you want it? (optional)"/>
            <TextBox x:Name="AskNote" FontSize="18" Height="50" Padding="12,0" MaxLength="200"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button Style="{DynamicResource Pill}" Background="{DynamicResource Well}" Foreground="{DynamicResource Text}" Content="Never mind" Click="CancelAsk"/>
              <Button x:Name="AskSend" Style="{DynamicResource Pill}" Margin="0" Content="Ask Mom or Dad" Click="ConfirmAsk"/>
            </StackPanel>
            <TextBlock x:Name="AskStatus" FontSize="15" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ======================= Theme picker ======================= -->
    <Grid x:Name="ThemeOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1160">
        <Border Style="{DynamicResource Shadow}"/>
        <Border Style="{DynamicResource CardBox}" Padding="30,26,14,22">
          <StackPanel>
            <DockPanel Margin="0,0,16,18">
              <Button DockPanel.Dock="Right" Style="{DynamicResource Pill}" Margin="0" Content="Done" Click="CloseThemes"/>
              <TextBlock FontSize="30" FontFamily="{DynamicResource Display}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Text="Pick your look"/>
            </DockPanel>
            <WrapPanel x:Name="ThemeChoices"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ======================= Family chat (above the lock screen, so he can always reach Mom and Dad) ======================= -->
    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,44,40">
      <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button x:Name="ChatPill" Style="{DynamicResource Pill}" Margin="0" FontSize="19" Padding="24,14,24,15" Click="ToggleChat">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8BD;" FontFamily="{DynamicResource Icons}" FontSize="21" VerticalAlignment="Center" Margin="0,2,10,0"/>
            <TextBlock Text="Family chat" VerticalAlignment="Center"/>
            <Border x:Name="ChatBadge" Background="{DynamicResource Bad}" CornerRadius="12" MinWidth="24" Height="24" Padding="6,0" Margin="10,0,0,0" Visibility="Collapsed">
              <TextBlock x:Name="ChatBadgeText" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Button>
      </Grid>
      <Grid x:Name="ChatPanel" Visibility="Collapsed" Width="430" Height="580">
        <Border Style="{DynamicResource Shadow}"/>
        <Border Style="{DynamicResource CardBox}" Padding="18">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,14">
              <Button DockPanel.Dock="Right" Style="{DynamicResource Pill}" Margin="0" FontSize="15" Padding="16,7,16,8" Background="{DynamicResource Well}" Foreground="{DynamicResource Text}" Content="Hide" Click="ToggleChat"/>
              <TextBlock Text="Family chat" FontSize="24" FontFamily="{DynamicResource Display}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button DockPanel.Dock="Right" Style="{DynamicResource Pill}" Margin="10,0,0,0" Content="Send" Click="SendChat"/>
              <TextBox x:Name="ChatBox" FontSize="17" Height="48" Padding="12,0" MaxLength="500" KeyDown="ChatKeyDown" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="ChatStatus" DockPanel.Dock="Bottom" FontSize="13" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
            <Border Background="{DynamicResource Well}" CornerRadius="{DynamicResource RButton}" Padding="12,12,4,12">
              <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatLog" Margin="0,0,8,0"/>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
