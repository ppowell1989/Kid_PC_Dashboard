<Window x:Class="KidsPc.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="False" ShowInTaskbar="False" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Body}" Foreground="{StaticResource Text}" UseLayoutRounding="True">
  <Grid>
    <!-- Soft washes of colour behind everything (drawn in code, MainWindow.Backdrop.cs) -->
    <Canvas x:Name="Backdrop" IsHitTestVisible="False" ClipToBounds="True"/>

    <!-- ======================= Home / catalogue ======================= -->
    <DockPanel Margin="56,40,56,36">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,26">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Greeting" FontSize="52" FontFamily="{StaticResource Display}" Text="Hi!"/>
          <TextBlock x:Name="Clock" FontSize="19" Foreground="{StaticResource Muted}" Margin="2,2,0,0"/>
        </StackPanel>

        <!-- Time left today -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Width="390">
          <Border Style="{StaticResource Shadow}"/>
          <Border Background="{StaticResource Card}" CornerRadius="22" Padding="24,14,24,20">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="TimeLeftLabel" DockPanel.Dock="Left" VerticalAlignment="Bottom" Margin="0,0,0,9"
                           FontSize="16" Foreground="{StaticResource Muted}" Text="Time left today"/>
                <TextBlock x:Name="TimeLeft" HorizontalAlignment="Right" FontSize="38" FontFamily="{StaticResource Display}" Text="--"/>
              </DockPanel>
              <Border Height="12" CornerRadius="6" Background="{StaticResource Well}" Margin="0,6,0,0">
                <Grid x:Name="FuelLane" Width="342" HorizontalAlignment="Left">
                  <Border x:Name="FuelFill" HorizontalAlignment="Left" Width="0" CornerRadius="6" Background="{StaticResource FuelOk}"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- A message from Mom or Dad -->
      <Border x:Name="MessageBanner" DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" BorderBrush="#C3D2FF" BorderThickness="2" CornerRadius="20"
              Padding="22,12,12,12" Margin="0,0,0,16" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="14,0,0,0" Content="OK" Click="DismissMessage"/>
          <TextBlock DockPanel.Dock="Left" Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock x:Name="MessageText" FontSize="23" FontFamily="{StaticResource Display}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- Time is nearly up -->
      <Border x:Name="WarningBanner" DockPanel.Dock="Top" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnLine}" BorderThickness="2" CornerRadius="20"
              Padding="22,14" Margin="0,0,0,16" Visibility="Collapsed">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource WarnText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock x:Name="WarningText" Foreground="{StaticResource WarnText}" FontSize="22" FontFamily="{StaticResource Display}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,26">
        <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0" Background="{StaticResource Card}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"
                Tag="15" Click="AskForTimeHome">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,10,0"/>
            <TextBlock Text="Ask for more time" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border HorizontalAlignment="Left" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="19" Padding="4">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="NavHome" Style="{StaticResource Nav}" Tag="on" Content="My games" Click="ShowHome"/>
            <Button x:Name="NavMore" Style="{StaticResource Nav}" Margin="4,0,0,0" Content="Get more games" Click="ShowCatalogue"/>
          </StackPanel>
        </Border>
      </DockPanel>

      <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Foreground="{StaticResource WarnText}" FontSize="17" Margin="0,8,0,0"/>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-20,-14,-20,0" Padding="20,14,20,0">
        <StackPanel>
          <WrapPanel x:Name="HomeTiles"/>
          <StackPanel x:Name="CataloguePanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,16" Text="Games Mom and Dad have approved"/>
            <WrapPanel x:Name="CatalogueTiles"/>
            <TextBlock Style="{StaticResource Heading}" Margin="0,18,0,16" Text="Want something else? Search for it"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="AskGameBox" Width="460" Height="52" FontSize="20" Padding="14,0" KeyDown="SearchKeyDown"/>
              <Button Style="{StaticResource Pill}" Margin="14,0,0,0" Content="Search" Click="SearchGames"/>
              <Button Style="{StaticResource Pill}" Margin="12,0,0,0" Background="{StaticResource Card}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" Content="Ask for it by name" Click="AskForGame"/>
            </StackPanel>
            <TextBlock x:Name="SearchStatus" FontSize="18" Foreground="{StaticResource Muted}" Margin="2,14,0,0" TextWrapping="Wrap"/>
            <WrapPanel x:Name="SearchResults" Margin="0,16,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ======================= Lock screen ======================= -->
    <Grid x:Name="LockOverlay" Background="{StaticResource Bg}" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="1000">
        <Grid Width="132" Height="132" Margin="0,0,0,30">
          <Ellipse Fill="{StaticResource AccentSoft}"/>
          <TextBlock Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="60" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="LockTitle" FontSize="56" FontFamily="{StaticResource Display}" TextAlignment="Center" TextWrapping="Wrap" Text="Time's up for today"/>
        <TextBlock x:Name="LockSub" FontSize="24" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,28"/>
        <Border x:Name="LockMessageCard" HorizontalAlignment="Center" Background="{StaticResource AccentSoft}" CornerRadius="18" Padding="24,14" Margin="0,0,0,28"
                Visibility="{Binding Visibility, ElementName=LockMessage}">
          <TextBlock x:Name="LockMessage" FontSize="24" FontFamily="{StaticResource Display}" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource Pill}" FontSize="20" Padding="28,15,28,16" Content="Ask for 15 more minutes" Tag="15" Click="AskForTime"/>
          <Button Style="{StaticResource Pill}" FontSize="20" Padding="28,15,28,16" Margin="0" Background="{StaticResource Card}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" Content="Ask for 30" Tag="30" Click="AskForTime"/>
        </StackPanel>
        <TextBlock x:Name="LockStatus" FontSize="18" Foreground="{StaticResource Good}" TextAlignment="Center" Margin="0,20,0,0"/>
        <Button Style="{StaticResource Pill}" Margin="0,40,0,0" HorizontalAlignment="Center" Background="Transparent" Foreground="{StaticResource Muted}" BorderBrush="{StaticResource Line}" Content="Shut down" Click="ShutDown"/>
      </StackPanel>
    </Grid>

    <!-- ======================= "Ask Mom or Dad for this game?" ======================= -->
    <Grid x:Name="AskOverlay" Background="{StaticResource Scrim}" Visibility="Collapsed">
      <Grid Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource Shadow}" CornerRadius="28"/>
        <Border Background="{StaticResource Card}" CornerRadius="28" Padding="30">
          <StackPanel>
            <TextBlock FontSize="17" Foreground="{StaticResource Muted}" Margin="0,-4,0,14" Text="Ask Mom or Dad for this game?"/>
            <Border CornerRadius="18" Height="262" Background="{StaticResource Well}" Margin="0,0,0,18">
              <Border CornerRadius="18">
                <Border.Background><ImageBrush x:Name="AskArt" Stretch="UniformToFill"/></Border.Background>
              </Border>
            </Border>
            <TextBlock x:Name="AskTitle" FontSize="32" FontFamily="{StaticResource Display}" TextWrapping="Wrap"/>
            <Border HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3,10,4" CornerRadius="8" Background="{StaticResource Well}">
              <TextBlock x:Name="AskRating" FontSize="14" Foreground="{StaticResource Muted}"/>
            </Border>
            <TextBlock x:Name="AskBlurb" FontSize="16" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,12,0,0" MaxHeight="88"/>
            <TextBlock FontSize="17" FontFamily="{StaticResource Display}" Margin="0,18,0,8" Text="Why do you want it? (optional)"/>
            <TextBox x:Name="AskNote" FontSize="18" Height="50" Padding="12,0" MaxLength="200"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button Style="{StaticResource Pill}" Background="{StaticResource Well}" Foreground="{StaticResource Text}" Content="Never mind" Click="CancelAsk"/>
              <Button x:Name="AskSend" Style="{StaticResource Pill}" Margin="0" Content="Ask Mom or Dad" Click="ConfirmAsk"/>
            </StackPanel>
            <TextBlock x:Name="AskStatus" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ======================= Family chat (above the lock screen, so he can always reach Mom and Dad) ======================= -->
    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,44,40">
      <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Border Style="{StaticResource Shadow}" CornerRadius="14" Background="#3D6BF5"/>
        <Button x:Name="ChatPill" Style="{StaticResource Pill}" Margin="0" FontSize="19" Padding="24,14,24,15" Click="ToggleChat">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="21" VerticalAlignment="Center" Margin="0,2,10,0"/>
            <TextBlock Text="Family chat" VerticalAlignment="Center"/>
            <Border x:Name="ChatBadge" Background="{StaticResource Bad}" CornerRadius="12" MinWidth="24" Height="24" Padding="6,0" Margin="10,0,0,0" Visibility="Collapsed">
              <TextBlock x:Name="ChatBadgeText" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Button>
      </Grid>
      <Grid x:Name="ChatPanel" Visibility="Collapsed" Width="430" Height="580">
        <Border Style="{StaticResource Shadow}" CornerRadius="26"/>
        <Border Background="{StaticResource Card}" CornerRadius="26" Padding="18">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,14">
              <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0" FontSize="15" Padding="16,7,16,8" Background="{StaticResource Well}" Foreground="{StaticResource Text}" Content="Hide" Click="ToggleChat"/>
              <TextBlock Text="Family chat" FontSize="24" FontFamily="{StaticResource Display}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="10,0,0,0" Content="Send" Click="SendChat"/>
              <TextBox x:Name="ChatBox" FontSize="17" Height="48" Padding="12,0" MaxLength="500" KeyDown="ChatKeyDown" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="ChatStatus" DockPanel.Dock="Bottom" FontSize="13" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
            <Border Background="{StaticResource Well}" CornerRadius="18" Padding="12,12,4,12">
              <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatLog" Margin="0,0,8,0"/>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
