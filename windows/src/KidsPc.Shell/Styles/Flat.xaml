<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- "Flat" control shapes: soft-shadowed cards and flat buttons. Colours, fonts and corner sizes come from the
       theme that pulls this file in (Themes\*.xaml), always by DynamicResource so a theme can be swapped while
       the shell is running. -->
  <!-- No implicit TextBlock style on purpose: it would override the font and colour that buttons hand down
       to their labels. The window sets the body font and text colour; everything inherits from there. -->

  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Headline}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>

  <!-- Big titles: "Hi, Adam!", the lock screen, the time left. -->
  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Headline}"/>
    <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
  </Style>

  <!-- A card: time left, the ask card, family chat, the theme picker. -->
  <Style x:Key="CardBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RCard}"/>
  </Style>

  <!-- The tray the two top tabs sit in. -->
  <Style x:Key="NavTray" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RCard}"/>
    <Setter Property="Padding" Value="4"/>
  </Style>

  <!-- A white card's soft shadow, drawn on its own plain shape behind the card so the card's contents stay crisp. -->
  <Style x:Key="Shadow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RCard}"/>
    <Setter Property="Effect">
      <Setter.Value><DropShadowEffect Color="#1A2238" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.14"/></Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="Transparent" CornerRadius="5">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="5" Background="{DynamicResource Thumb}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="FontFamily" Value="{DynamicResource Body}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="{DynamicResource RButton}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Game tile: a white card with the art on top and the name below. Lifts a little on hover.
       Background = the art (or a soft poster colour), Tag = an icon glyph for tiles with no art. -->
  <Style x:Key="Tile" TargetType="Button">
    <Setter Property="Width" Value="338"/>
    <Setter Property="Height" Value="238"/>
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    <Setter Property="Margin" Value="0,0,22,22"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="sh" Style="{StaticResource Shadow}" CornerRadius="{DynamicResource RTile}" Opacity="0.75"/>
            <Border x:Name="b" CornerRadius="{DynamicResource RTile}" Background="{DynamicResource Card}" BorderBrush="Transparent" BorderThickness="3">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border CornerRadius="{DynamicResource RTileTop}" Background="{TemplateBinding Background}"/>
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{DynamicResource Icons}"
                           FontSize="64" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Grid.Row="1" MinHeight="68" Padding="18,10,18,12">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sh" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sh" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Button. Blue by default; set Background and Foreground for a quiet (Well + Text) or a red one. -->
  <Style x:Key="Pill" TargetType="Button">
    <Setter Property="Padding" Value="22,11,22,12"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="p" CornerRadius="{DynamicResource RButton}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"/>
            <Border x:Name="o" CornerRadius="{DynamicResource RButton}" Background="{DynamicResource Text}" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="o" Property="Opacity" Value="0.07"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="o" Property="Opacity" Value="0.16"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="p" Property="BorderBrush" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Top tabs. Tag="on" marks the page you are on. -->
  <Style x:Key="Nav" TargetType="Button">
    <Setter Property="Height" Value="50"/>
    <Setter Property="Padding" Value="24,0"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="f" CornerRadius="{DynamicResource RButton}" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="f" Property="Background" Value="{DynamicResource Well}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="on">
              <Setter TargetName="f" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="f" Property="BorderBrush" Value="{DynamicResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
