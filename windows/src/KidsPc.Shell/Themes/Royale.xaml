<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Royale: loud and bright like a party battle game. Purple to blue sky, yellow buttons, fat rounded type.
       A theme is this one file: a set of colours, fonts and corner sizes, plus which control shapes to use
       (Styles\Flat.xaml or Styles\Chunky.xaml). To add a theme, copy this file, change the values, and add a
       line to Theme.All in Theme.cs. Every key below must be present. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/KidsPcShell;component/Styles/Chunky.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#3A1FA8" Offset="0"/>
    <GradientStop Color="#6A2BD9" Offset="0.5"/>
    <GradientStop Color="#1E7FE5" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Card" Color="#F21B1464"/>
  <SolidColorBrush x:Key="Well" Color="#E6120C48"/>
  <SolidColorBrush x:Key="Line" Color="#7B6CFF"/>
  <SolidColorBrush x:Key="Thumb" Color="#7B6CFF"/>
  <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Muted" Color="#CFC8FF"/>
  <SolidColorBrush x:Key="Accent" Color="#FFD400"/>
  <SolidColorBrush x:Key="OnAccent" Color="#1A1240"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#55FFD400"/>
  <SolidColorBrush x:Key="AccentLine" Color="#FFD400"/>
  <SolidColorBrush x:Key="Good" Color="#5CFF8A"/>
  <SolidColorBrush x:Key="Bad" Color="#FF4D6D"/>
  <SolidColorBrush x:Key="WarnSoft" Color="#FFD400"/>
  <SolidColorBrush x:Key="WarnLine" Color="#1A1240"/>
  <SolidColorBrush x:Key="WarnText" Color="#1A1240"/>
  <SolidColorBrush x:Key="Scrim" Color="#CC0E0830"/>
  <SolidColorBrush x:Key="TitleBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BubbleParent" Color="#3A2DA8"/>
  <SolidColorBrush x:Key="BubbleSibling" Color="#1668B8"/>
  <SolidColorBrush x:Key="BubbleText" Color="#FFFFFF"/>
  <DropShadowEffect x:Key="TitleEffect" Color="#1A1240" BlurRadius="0" ShadowDepth="6" Direction="315" Opacity="0.9"/>
  <SolidColorBrush x:Key="FuelOk" Color="#5CFF8A"/>
  <SolidColorBrush x:Key="FuelLow" Color="#FFD400"/>
  <SolidColorBrush x:Key="FuelEmpty" Color="#FF4D6D"/>

  <FontFamily x:Key="Display">/KidsPcShell;component/Assets/Fonts/#Lilita One, Segoe UI Black, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">/KidsPcShell;component/Assets/Fonts/#Nunito Text, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="TileTitleFont">/KidsPcShell;component/Assets/Fonts/#Lilita One, Segoe UI Black, Segoe UI</FontFamily>

  <CornerRadius x:Key="RCard">20</CornerRadius>
  <CornerRadius x:Key="RTile">20</CornerRadius>
  <CornerRadius x:Key="RTileTop">16,16,0,0</CornerRadius>
  <CornerRadius x:Key="RButton">16</CornerRadius>

  <!-- Poster colours for tiles with no art, taken in turn. -->
  <x:Array x:Key="PosterColours" Type="Color"><Color>#FFD400</Color><Color>#40C4FF</Color><Color>#FF6FD8</Color><Color>#5CFF8A</Color></x:Array>
  <!-- Frame colours tiles take in turn (Chunky shapes only). -->
  <x:Array x:Key="TileFrames" Type="Color"><Color>#FFD400</Color><Color>#40C4FF</Color><Color>#FF6FD8</Color><Color>#5CFF8A</Color></x:Array>
  <!-- Which backdrop MainWindow.Backdrop.cs draws, and whether the bottom ticker shows. -->
  <sys:String x:Key="Backdrop">rays</sys:String>
  <Visibility x:Key="TickerVisibility">Collapsed</Visibility>
</ResourceDictionary>
