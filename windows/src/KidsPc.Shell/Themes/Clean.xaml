<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Clean: light and calm. White rounded cards, one blue accent. The default.
       A theme is this one file: a set of colours, fonts and corner sizes, plus which control shapes to use
       (Styles\Flat.xaml or Styles\Chunky.xaml). To add a theme, copy this file, change the values, and add a
       line to Theme.All in Theme.cs. Every key below must be present. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/KidsPcShell;component/Styles/Flat.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F8FAFE" Offset="0"/>
    <GradientStop Color="#EDF2FB" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Well" Color="#EFF3FA"/>
  <SolidColorBrush x:Key="Line" Color="#E1E7F2"/>
  <SolidColorBrush x:Key="Thumb" Color="#C5CEDF"/>
  <SolidColorBrush x:Key="Text" Color="#18213A"/>
  <SolidColorBrush x:Key="Muted" Color="#67718B"/>
  <SolidColorBrush x:Key="Accent" Color="#3D6BF5"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#E7EDFF"/>
  <SolidColorBrush x:Key="AccentLine" Color="#C3D2FF"/>
  <SolidColorBrush x:Key="Good" Color="#1FA971"/>
  <SolidColorBrush x:Key="Bad" Color="#E5484D"/>
  <SolidColorBrush x:Key="WarnSoft" Color="#FFF3D1"/>
  <SolidColorBrush x:Key="WarnLine" Color="#F2C14E"/>
  <SolidColorBrush x:Key="WarnText" Color="#6B4700"/>
  <SolidColorBrush x:Key="Scrim" Color="#8018213A"/>
  <SolidColorBrush x:Key="TitleBrush" Color="#18213A"/>
  <SolidColorBrush x:Key="BubbleParent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BubbleSibling" Color="#DDF4EA"/>
  <SolidColorBrush x:Key="BubbleText" Color="#18213A"/>
  <SolidColorBrush x:Key="FuelOk" Color="#1FA971"/>
  <SolidColorBrush x:Key="FuelLow" Color="#F2A20C"/>
  <SolidColorBrush x:Key="FuelEmpty" Color="#E5484D"/>

  <FontFamily x:Key="Display">/KidsPcShell;component/Assets/Fonts/#Nunito Display, Segoe UI Semibold, Segoe UI</FontFamily>
  <FontFamily x:Key="Headline">/KidsPcShell;component/Assets/Fonts/#Nunito Display, Segoe UI Semibold, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">/KidsPcShell;component/Assets/Fonts/#Nunito Text, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="TileTitleFont">/KidsPcShell;component/Assets/Fonts/#Nunito Display, Segoe UI Semibold, Segoe UI</FontFamily>

  <CornerRadius x:Key="RCard">22</CornerRadius>
  <CornerRadius x:Key="RTile">22</CornerRadius>
  <CornerRadius x:Key="RTileTop">19,19,0,0</CornerRadius>
  <CornerRadius x:Key="RButton">14</CornerRadius>

  <!-- Poster colours for tiles with no art, taken in turn. -->
  <x:Array x:Key="PosterColours" Type="Color"><Color>#3D6BF5</Color><Color>#1FA971</Color><Color>#F28C28</Color><Color>#7C5CFC</Color></x:Array>
  <!-- Which backdrop MainWindow.Backdrop.cs draws, and whether the bottom ticker shows. -->
  <sys:String x:Key="Backdrop">washes</sys:String>
  <Visibility x:Key="TickerVisibility">Collapsed</Visibility>
</ResourceDictionary>
