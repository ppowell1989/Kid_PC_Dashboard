<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Blocks: a blocky build-anything world. Blue sky, grass and dirt, square corners, pixel headlines.
       A theme is this one file: a set of colours, fonts and corner sizes, plus which control shapes to use
       (Styles\Flat.xaml or Styles\Chunky.xaml). To add a theme, copy this file, change the values, and add a
       line to Theme.All in Theme.cs. Every key below must be present. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/KidsPcShell;component/Styles/Chunky.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#6FBDEE" Offset="0"/>
    <GradientStop Color="#C4E8FB" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Card" Color="#F3ECDC"/>
  <SolidColorBrush x:Key="Well" Color="#DDD2BB"/>
  <SolidColorBrush x:Key="Line" Color="#5B4632"/>
  <SolidColorBrush x:Key="Thumb" Color="#5B4632"/>
  <SolidColorBrush x:Key="Text" Color="#2B2118"/>
  <SolidColorBrush x:Key="Muted" Color="#6B5A48"/>
  <SolidColorBrush x:Key="Accent" Color="#4E9A2E"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#DCEFC9"/>
  <SolidColorBrush x:Key="AccentLine" Color="#4E9A2E"/>
  <SolidColorBrush x:Key="Good" Color="#2F7D1F"/>
  <SolidColorBrush x:Key="Bad" Color="#C0392B"/>
  <SolidColorBrush x:Key="WarnSoft" Color="#FFE08A"/>
  <SolidColorBrush x:Key="WarnLine" Color="#8A5A00"/>
  <SolidColorBrush x:Key="WarnText" Color="#4A3200"/>
  <SolidColorBrush x:Key="Scrim" Color="#99201810"/>
  <SolidColorBrush x:Key="TitleBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BubbleParent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BubbleSibling" Color="#DCEFC9"/>
  <SolidColorBrush x:Key="BubbleText" Color="#2B2118"/>
  <DropShadowEffect x:Key="TitleEffect" Color="#2B2118" BlurRadius="0" ShadowDepth="5" Direction="315" Opacity="0.85"/>
  <SolidColorBrush x:Key="FuelOk" Color="#4E9A2E"/>
  <SolidColorBrush x:Key="FuelLow" Color="#E0A21A"/>
  <SolidColorBrush x:Key="FuelEmpty" Color="#C0392B"/>

  <!-- Pixel type (Jersey 15) only for big headlines, where it reads well; buttons, tile names and messages use
       Russo One, a square, solid face that keeps the blocky feel at small sizes. Both OFL, bundled. -->
  <FontFamily x:Key="Headline">/KidsPcShell;component/Assets/Fonts/#Jersey 15, Russo One, Segoe UI</FontFamily>
  <FontFamily x:Key="Display">/KidsPcShell;component/Assets/Fonts/#Russo One, Segoe UI Semibold, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">/KidsPcShell;component/Assets/Fonts/#Nunito Text, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="TileTitleFont">/KidsPcShell;component/Assets/Fonts/#Russo One, Segoe UI Semibold, Segoe UI</FontFamily>

  <CornerRadius x:Key="RCard">4</CornerRadius>
  <CornerRadius x:Key="RTile">4</CornerRadius>
  <CornerRadius x:Key="RTileTop">0</CornerRadius>
  <CornerRadius x:Key="RButton">4</CornerRadius>

  <!-- Poster colours for tiles with no art, taken in turn. -->
  <x:Array x:Key="PosterColours" Type="Color"><Color>#4E9A2E</Color><Color>#3D8BD4</Color><Color>#C9772B</Color><Color>#7A5AC2</Color></x:Array>
  <!-- Frame colours tiles take in turn (Chunky shapes only). -->
  <x:Array x:Key="TileFrames" Type="Color"><Color>#5B4632</Color></x:Array>
  <!-- Which backdrop MainWindow.Backdrop.cs draws, and whether the bottom ticker shows. -->
  <sys:String x:Key="Backdrop">blocks</sys:String>
  <Visibility x:Key="TickerVisibility">Collapsed</Visibility>
</ResourceDictionary>
