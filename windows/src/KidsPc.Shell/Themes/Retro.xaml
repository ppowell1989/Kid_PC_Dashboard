<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Retro space: a 1990s web page in space. Black sky, neon planets, chunky glowing type.
       A theme is this one file: a set of colours, fonts and corner sizes, plus which control shapes to use
       (Styles\Flat.xaml or Styles\Chunky.xaml). To add a theme, copy this file, change the values, and add a
       line to Theme.All in Theme.cs. Every key below must be present. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/KidsPcShell;component/Styles/Chunky.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <RadialGradientBrush x:Key="Bg" Center="0.25,0.1" GradientOrigin="0.25,0.1" RadiusX="1.1" RadiusY="1.1">
    <GradientStop Color="#1B0B4A" Offset="0"/>
    <GradientStop Color="#0B0628" Offset="0.5"/>
    <GradientStop Color="#03020F" Offset="1"/>
  </RadialGradientBrush>
  <SolidColorBrush x:Key="Card" Color="#F2140C44"/>
  <SolidColorBrush x:Key="Well" Color="#E60A0630"/>
  <SolidColorBrush x:Key="Line" Color="#4B3BB0"/>
  <SolidColorBrush x:Key="Thumb" Color="#9B5CFF"/>
  <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Muted" Color="#B3A9E8"/>
  <SolidColorBrush x:Key="Accent" Color="#FF2E97"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#66FF2E97"/>
  <SolidColorBrush x:Key="AccentLine" Color="#FF2E97"/>
  <SolidColorBrush x:Key="Good" Color="#7DFF5A"/>
  <SolidColorBrush x:Key="Bad" Color="#FF4D5E"/>
  <SolidColorBrush x:Key="WarnSoft" Color="#FFD23F"/>
  <SolidColorBrush x:Key="WarnLine" Color="#1B1D21"/>
  <SolidColorBrush x:Key="WarnText" Color="#1B1D21"/>
  <SolidColorBrush x:Key="Scrim" Color="#D903020F"/>
  <SolidColorBrush x:Key="BubbleParent" Color="#3B2A8F"/>
  <SolidColorBrush x:Key="BubbleSibling" Color="#0E6B7A"/>
  <SolidColorBrush x:Key="BubbleText" Color="#FFFFFF"/>
  <LinearGradientBrush x:Key="TitleBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFF48A" Offset="0.1"/>
    <GradientStop Color="#FFD23F" Offset="0.5"/>
    <GradientStop Color="#FF8A00" Offset="0.95"/>
  </LinearGradientBrush>
  <DropShadowEffect x:Key="TitleEffect" Color="#FF2E97" BlurRadius="0" ShadowDepth="6" Direction="315" Opacity="1"/>
  <LinearGradientBrush x:Key="FuelOk" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#7DFF5A" Offset="0"/><GradientStop Color="#C8FF5A" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="FuelLow" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF8A00" Offset="0"/><GradientStop Color="#FFD23F" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="FuelEmpty" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C4102C" Offset="0"/><GradientStop Color="#FF4D5E" Offset="1"/></LinearGradientBrush>

  <FontFamily x:Key="Display">/KidsPcShell;component/Assets/Fonts/#Bungee, Bahnschrift SemiBold, Segoe UI Black, Segoe UI</FontFamily>
  <FontFamily x:Key="Headline">/KidsPcShell;component/Assets/Fonts/#Bungee, Bahnschrift SemiBold, Segoe UI Black, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">Bahnschrift, Segoe UI Variable, Segoe UI</FontFamily>
  <FontFamily x:Key="TileTitleFont">Bahnschrift SemiBold, Segoe UI Semibold, Segoe UI</FontFamily>

  <CornerRadius x:Key="RCard">24</CornerRadius>
  <CornerRadius x:Key="RTile">24</CornerRadius>
  <CornerRadius x:Key="RTileTop">20,20,0,0</CornerRadius>
  <CornerRadius x:Key="RButton">16</CornerRadius>

  <!-- Poster colours for tiles with no art, taken in turn. -->
  <x:Array x:Key="PosterColours" Type="Color"><Color>#22E4FF</Color><Color>#FF2E97</Color><Color>#FFD23F</Color><Color>#7DFF5A</Color><Color>#FF8A00</Color><Color>#9B5CFF</Color></x:Array>
  <!-- Frame colours tiles take in turn (Chunky shapes only). -->
  <x:Array x:Key="TileFrames" Type="Color"><Color>#22E4FF</Color><Color>#FF2E97</Color><Color>#FFD23F</Color><Color>#7DFF5A</Color><Color>#FF8A00</Color><Color>#9B5CFF</Color></x:Array>
  <!-- Which backdrop MainWindow.Backdrop.cs draws, and whether the bottom ticker shows. -->
  <sys:String x:Key="Backdrop">space</sys:String>
  <Visibility x:Key="TickerVisibility">Visible</Visibility>
</ResourceDictionary>
